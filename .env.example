# This file holds no secrets when the Atlassian MCP is connected.
#   Jira   -> Atlassian MCP (preferred), token below only as a fallback
#   GitHub -> `gh` credential store: gh auth login --hostname HOST --git-protocol ssh --web
JIRA_URL=https://your-site.atlassian.net

# Only needed when the Atlassian MCP is NOT available. Leave empty otherwise.
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

MAIN_BRANCH=develop
TEST_URL_PATTERN=

# Optional: git remote to read the repository from (default: origin)
# GIT_REMOTE=origin

# Optional: expected GitHub Enterprise host — only used to catch a wrong-repo mistake.
# Leave empty to trust whatever the git remote points at.
# GH_HOST=your-host.ghe.com

# Optional: custom commands (leave empty to auto-detect or skip)
# TEST_CMD=yarn run test
# LINT_CMD=scripts/lint-changed.sh --merge-base origin/main
# FMT_CMD=yarn run prettier --write .
# JIRA_LIST_JQL=project = MYPROJ AND assignee = currentUser() AND sprint in openSprints() ORDER BY priority ASC
