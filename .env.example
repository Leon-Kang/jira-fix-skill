ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=your-jira-api-token
BB_API_TOKEN=your-bitbucket-api-token
JIRA_URL=https://your-site.atlassian.net
BB_WORKSPACE=your-bitbucket-workspace
MAIN_BRANCH=develop
TEST_URL_PATTERN=

